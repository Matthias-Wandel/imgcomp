#! /bin/bash
# This script setups up imgcomp, but without starting it at boot
# For it to run at boot, plase run setup-imgcomp-autorun after this script
# Make sure the camera is enabled

# ---- Configurable paths ----
# PROJECT_DIR: root of the imgcomp source tree (auto-detected from script location)
PROJECT_DIR="$(cd "$(dirname "$0")/.." && pwd)"
# WWW_DIR: web root served by apache2
WWW_DIR="${WWW_DIR:-$PROJECT_DIR/www}"
# IMAGES_DIR: where captured images are stored
IMAGES_DIR="${IMAGES_DIR:-$PROJECT_DIR/images}"
# CONF_DIR: where imgcomp.conf is placed
CONF_DIR="${CONF_DIR:-$PROJECT_DIR}"
# ---- End configurable paths ----

if [ "$EUID" -eq 0 ]
    then echo "Please do NOT run this sript as root"
    exit
fi

# If it's older buster, make sure camera support is enabled.
# With bullseye (version 11) we can use libcamera-still
# without explicitly enabling camera support
if grep -q 'VERSION_ID="10"' /etc/os-release; then
	if grep -q "start_x\=1" /boot/config.txt; then
		echo "    camera module is already enabled"
	else
		echo "camera is not enabled."
		echo "Run raspi-config to enable it under 'Interfacing Options'"
		exit 1
	fi
fi

# Create new web root directory.  These two commands must NOT run as root.
echo "Make directories for apache2"
echo "  WWW_DIR=$WWW_DIR"
echo "  IMAGES_DIR=$IMAGES_DIR"
mkdir -p "$WWW_DIR"
mkdir -p "$IMAGES_DIR"
ln -sTf "$IMAGES_DIR" "$WWW_DIR/pix"

echo "Make web and image directories readable by web server"
# Make directories publicly readable (so www-data process can access it)
chmod +rx "$WWW_DIR"
chmod +rx "$IMAGES_DIR"

# Make sure an imgcomp.conf configuration file exists
if [ -e "$CONF_DIR/imgcomp.conf" ] ; then
	echo "    imgcomp.conf file already in $CONF_DIR"
else
	echo "copy imgcomp.conf.example to $CONF_DIR/imgcomp.conf"
	cp -a "$PROJECT_DIR/conf-examples/imgcomp.conf.example" "$CONF_DIR/imgcomp.conf"
fi

# Make sure a browse configuration file exists
if [ -e "$WWW_DIR/browse.conf" ] ; then
	echo "    browse.conf file already in www directory"
else
	echo "copy browse.conf.example to $WWW_DIR/browse.conf"
	cp -a "$PROJECT_DIR/conf-examples/browse.conf.example" "$WWW_DIR/browse.conf"
fi

if [ ! -f "$PROJECT_DIR/imgcomp" ]; then
	echo "Building imgcomp first."
	echo
	make -C "$PROJECT_DIR"
fi


if [ ! -f "$PROJECT_DIR/browse/view.cgi" ]; then
	echo "Compiling imgcomp/browse"
	echo ""
	make -C "$PROJECT_DIR/browse" WWW_DIR="$WWW_DIR"
fi

if crontab -l 2>/dev/null | grep -q "imgcomp"; then
        echo "    crontab entry for starting at startup already exists"
else
        echo "Adding crontab entry to start imgcomp at startup"
        ( crontab -l 2>/dev/null; \
            echo "@reboot $PROJECT_DIR/imgcomp &"; \
            echo "0 * * * * $PROJECT_DIR/setup/relaunch_imgcomp" ) | crontab -
fi

if [ ! -d "/ramdisk" ]; then
	echo
	echo "You still need to run sudo ./setup-imgcomp-root"
fi





